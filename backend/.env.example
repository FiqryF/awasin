APP_NAME=AWASIN API
APP_ENV=development
APP_DEBUG=false
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
# Optional for public health; required for identity endpoints.
SUPABASE_URL=https://nqruowgbxiopfhslznyb.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Optional backend-only Supabase secret key for trusted URL history writes.
SUPABASE_HISTORY_SECRET_KEY=
SUPABASE_JWT_ALGORITHM=ES256
# Optional Google Web Risk Lookup. Leave disabled until provider and privacy review.
WEB_RISK_ENABLED=false
WEB_RISK_API_KEY=

# Google Safe Browsing v5 is for noncommercial use. A key enables the provider.
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
# Optional VirusTotal AI report lookup. Development can use ~/.config/vtai/token.
VTAI_ENABLED=true
VTAI_AGENT_TOKEN=
URLSCAN_API_KEY=
# Optional local JSON export of reviewed public domain references.
VERIFIED_DOMAIN_SNAPSHOT=

# Optional Mistral analyst. The service requires separate per-call consent.
AWASIN_AI_ENABLED=false
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-8b-latest

# Requires a verified Detector adapter and separate consent.
AI_THREAT_DETECTOR_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_DETECTOR_MODEL=nvidia/nemotron-3.5-super-vl:free
